# Salin ke .env.local untuk dev (file .env.local diabaikan git).
#
# EXPO_PUBLIC_API_URL menang atas hostUri (Expo Go) dan extra.apiUrl (app.json).
# Kosongkan/hapus agar aplikasi memakai perilaku bawaan:
#   - Expo Go/native : http://<ip-dev-server>:4000
#   - Web & produksi : extra.apiUrl dari app.json
#
# - Pengembangan (npm run web / expo start):  http://localhost:4000
#   - Di emulator Android gunakan:            http://10.0.2.2:4000
#     (localhost di emulator menunjuk ke emulator itu sendiri)
# - Build produksi (npm run build:web / EAS): https://pasukanzaydan.net
#   diambil dari app.json extra.apiUrl — jangan set env ini saat build produksi.
EXPO_PUBLIC_API_URL=http://localhost:4000
