{
  "expo": {
    "name": "TraderTrack",
    "slug": "tradertrack",
    "version": "0.1.0",
    "scheme": "tradertrack",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Izinkan TraderTrack mengakses kamera untuk memindai barcode resi dan mengambil foto bukti."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan TraderTrack mengambil foto bukti penyelesaian order."
        }
      ],
      "expo-status-bar"
    ],
    "android": {
      "package": "id.tradertrack.app"
    },
    "extra": {
      "apiUrl": "http://localhost:4000"
    }
  }
}
