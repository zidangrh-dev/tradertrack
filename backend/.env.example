# Salin ke .env dan sesuaikan.
# Tanpa DATABASE_URL server memakai repo memori (dev saja).

PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://tradertrack:tradertrack@localhost:5432/tradertrack

# JWT
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN=12h

# Uploads
UPLOADS_DIR=./uploads
